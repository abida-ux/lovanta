<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_vip_screen"
    tools:context=".VipActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="22dp"
        android:text="Assigned conversations"
        android:textColor="@color/lovanta_dark"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:text="Current conversations for your assigned models"
        android:textColor="@color/lovanta_gray"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVipModels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        tools:listitem="@layout/item_story" />

    <View
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:background="@color/lovanta_surface" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVipClients"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/lovanta_surface"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        tools:listitem="@layout/item_vip_client" />

    <TextView
        android:id="@+id/tvVipEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="24dp"
        android:text="No assigned conversations yet."
        android:textColor="@color/lovanta_gray"
        android:textSize="14sp"
        android:visibility="gone" />

    <include layout="@layout/bottom_navigation" />

</LinearLayout>
